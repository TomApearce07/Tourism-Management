<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

    <jsp-config>
        <taglib>
            <taglib-uri>http://viettour.com/tags</taglib-uri>
            <taglib-location>/WEB-INF/vt-tags.tld</taglib-location>
        </taglib>
    </jsp-config>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.viettour.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Chặn CSRF: POST/PUT/DELETE từ trang web khác bị từ chối (đặt sau EncodingFilter, trước các filter đăng nhập) -->
    <filter>
        <filter-name>SameOriginFilter</filter-name>
        <filter-class>com.viettour.filter.SameOriginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SameOriginFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.viettour.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/manager/*</url-pattern>
        <url-pattern>/provider/*</url-pattern>
        <url-pattern>/customer/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.viettour.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/manager/*</url-pattern>
        <url-pattern>/provider/*</url-pattern>
        <url-pattern>/customer/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.viettour.controller.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.viettour.controller.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.viettour.controller.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.HomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TourListServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.TourListServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TourDetailServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.TourDetailServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.CheckoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PaymentReturnServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.PaymentReturnServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookingHistoryServlet</servlet-name>
        <servlet-class>com.viettour.controller.publicweb.BookingHistoryServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProviderDashboardServlet</servlet-name>
        <servlet-class>com.viettour.controller.provider.ProviderDashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProviderTourServlet</servlet-name>
        <servlet-class>com.viettour.controller.provider.ProviderTourServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CreateTourServlet</servlet-name>
        <servlet-class>com.viettour.controller.provider.CreateTourServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>ProviderTourDetailServlet</servlet-name>
        <servlet-class>com.viettour.controller.provider.ProviderTourDetailServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>ProviderBookingServlet</servlet-name>
        <servlet-class>com.viettour.controller.provider.ProviderBookingServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ManagerOverviewServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.ManagerOverviewServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PendingApprovalsServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.PendingApprovalsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ApproveTourServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.ApproveTourServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ManageToursServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.ManageToursServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ManagerTourDetailServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.ManagerTourDetailServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ManageBookingsServlet</servlet-name>
        <servlet-class>com.viettour.controller.manager.ManageBookingsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UserManagementServlet</servlet-name>
        <servlet-class>com.viettour.controller.admin.UserManagementServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ToggleAccountServlet</servlet-name>
        <servlet-class>com.viettour.controller.admin.ToggleAccountServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
        <url-pattern></url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TourListServlet</servlet-name>
        <url-pattern>/tours</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TourDetailServlet</servlet-name>
        <url-pattern>/tour-detail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/customer/checkout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentReturnServlet</servlet-name>
        <url-pattern>/customer/payment-return</url-pattern>
        <url-pattern>/api/ipn-handler</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookingHistoryServlet</servlet-name>
        <url-pattern>/customer/history</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProviderDashboardServlet</servlet-name>
        <url-pattern>/provider/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProviderTourServlet</servlet-name>
        <url-pattern>/provider/my-tours</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CreateTourServlet</servlet-name>
        <url-pattern>/provider/create-tour</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProviderTourDetailServlet</servlet-name>
        <url-pattern>/provider/tour-detail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProviderBookingServlet</servlet-name>
        <url-pattern>/provider/booking-orders</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManagerOverviewServlet</servlet-name>
        <url-pattern>/manager/overview</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PendingApprovalsServlet</servlet-name>
        <url-pattern>/manager/pending-approvals</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApproveTourServlet</servlet-name>
        <url-pattern>/manager/approve-tour</url-pattern>
        <url-pattern>/manager/review-tour</url-pattern>
        <url-pattern>/manager/providers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManageToursServlet</servlet-name>
        <url-pattern>/manager/manage-tours</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManagerTourDetailServlet</servlet-name>
        <url-pattern>/manager/tour-detail</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ManageBookingsServlet</servlet-name>
        <url-pattern>/manager/bookings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserManagementServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ToggleAccountServlet</servlet-name>
        <url-pattern>/admin/toggle-account</url-pattern>
    </servlet-mapping>

    <!-- Chặn truy cập trực tiếp vào các trang JSP trong /views (chỉ servlet forward tới mới hiển thị được).
         Riêng /views/customer/sandbox-payment.jsp KHÔNG bị chặn vì đây là màn hình giả lập cổng thanh toán,
         CheckoutServlet chuyển thẳng khách tới đó. -->
    <security-constraint>
        <display-name>Block direct access to JSP views</display-name>
        <web-resource-collection>
            <web-resource-name>JSP views</web-resource-name>
            <url-pattern>/views/admin/*</url-pattern>
            <url-pattern>/views/auth/*</url-pattern>
            <url-pattern>/views/manager/*</url-pattern>
            <url-pattern>/views/provider/*</url-pattern>
            <url-pattern>/views/public/*</url-pattern>
            <url-pattern>/views/customer/checkout.jsp</url-pattern>
            <url-pattern>/views/customer/history.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>

    <!-- Cookie phiên: không cho JavaScript đọc, chỉ dùng cookie (không đưa session ID lên URL) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
